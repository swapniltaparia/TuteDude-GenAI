   "source": [
    "daily = [200, 150, 0, 400, 50, -1, 300]\n",
    "\n",
    "total_sales = 0\n",
    "\n",
    "for daily_revenue in daily:\n",
    "    if daily_revenue < 0:\n",
    "        break\n",
    "    \n",
    "    if daily_revenue == 0:\n",
    "        continue\n",
    "    \n",
    "    total_sales += daily_revenue\n",
    "    \n",
    "print(total_sales)\n"
   ]
  }
 ],
