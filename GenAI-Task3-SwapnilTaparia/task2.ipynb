   ],
   "source": [
    "def factorial(n):\n",
    "    if n < 0:\n",
    "        return 'Enter a non-negative integer'\n",
    "\n",
    "    if n == 0 or n == 1:\n",
    "        return 1\n",
    "\n",
    "    return n * factorial (n - 1)\n",
    "\n",
    "print(f\"The factorial of 5: {factorial(5)}\")\n",
    "print(f\"The factorial of 0: {factorial(0)}\")\n",
    "print(factorial(-3))"
   ]
  }
 ],
