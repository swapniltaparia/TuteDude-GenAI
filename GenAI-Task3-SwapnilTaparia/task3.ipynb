   "source": [
    "gst = lambda price: price * 1.18\n",
    "\n",
    "final_price_after_discount = lambda price, discount = 0.05: gst(price) * (1 - discount)\n",
    "\n",
    "print(f\"Price with GST: {gst(100)}\")\n",
    "print(f\"Price with GST (after discount): {final_price_after_discount(100)}\")"
   ]
  }
