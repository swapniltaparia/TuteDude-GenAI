   "source": [
    "def apply_discount(price, discount_percent = 5):\n",
    "    final_discount_fraction = min(discount_percent, 60) / 100\n",
    "    return price * (1 - final_discount_fraction)\n",
    "\n",
    "print(apply_discount(1000, 10))\n",
    "print(apply_discount(500))"
   ]
  }
